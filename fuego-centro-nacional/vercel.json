{
  "functions": {
    "api/air-quality.js": {
      "maxDuration": 20
    },
    "api/previfoc.js": {
      "maxDuration": 20
    },
    "api/infoar.js": {
      "maxDuration": 30
    },
    "api/situation.js": {
      "maxDuration": 45,
      "regions": ["fra1"]
    },
    "api/fire-perimeters.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/reverse-geocode",
      "destination": "/api/geocode"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Robots-Tag","value":"noindex"},
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"geolocation=(self), camera=(), microphone=()"}
      ]
    }
  ]
}
